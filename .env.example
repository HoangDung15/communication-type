# Các biến môi trường. Ở máy: file .env.local. Trên Vercel: Settings > Environment Variables.

# ---- Database Neon (lấy tự động bằng: neon env pull) ----
# Kết nối pooled cho ứng dụng
DATABASE_URL="postgresql://..."
# Kết nối trực tiếp, chỉ dùng cho npm run db:migrate
DATABASE_URL_UNPOOLED="postgresql://..."

# ---- Thông tin hiển thị ----
NEXT_PUBLIC_ORG_NAME="[Tên BTC]"

# ---- Sheet nội dung kết quả (chỉ dùng cho npm run sync-results, bỏ trống thì dùng sheet mặc định) ----
# Sheet phải để chế độ "Bất kỳ ai có đường liên kết đều có thể xem"
RESULTS_SHEET_ID=""

# ---- Email xác nhận (tuỳ chọn, bỏ trống để tắt) ----
# Dùng Gmail của BTC + App Password (Tài khoản Google > Bảo mật > Mật khẩu ứng dụng)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
