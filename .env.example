# Sao chép file này thành .env.local (chạy ở máy) và khai báo y hệt trong Vercel > Settings > Environment Variables.
# Khi chưa điền phần Google, đăng ký chỉ in ra console (chỉ ở chế độ dev).

# ---- Thông tin hiển thị ----
NEXT_PUBLIC_ORG_NAME="[Tên BTC]"

# ---- Sheet kết quả (chỉ dùng cho lệnh npm run sync-results, bỏ trống thì dùng sheet mặc định) ----
# Sheet phải để chế độ "Bất kỳ ai có đường liên kết đều có thể xem"
RESULTS_SHEET_ID=""

# ---- Google Service Account (dùng để ghi đăng ký) ----
GOOGLE_SERVICE_ACCOUNT_EMAIL="ten-tai-khoan@ten-project.iam.gserviceaccount.com"
# Dán nguyên private_key trong file JSON, giữ các ký tự \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---- Sheet tổng (nhận mọi đăng ký + tab Config danh sách quản lý) ----
MASTER_SHEET_ID="id-sheet-tong"
MASTER_REGISTRATIONS_TAB="DangKy"
MASTER_CONFIG_TAB="Config"

# ---- Email xác nhận (tuỳ chọn, bỏ trống để tắt) ----
# Dùng Gmail của BTC + App Password (Tài khoản Google > Bảo mật > Mật khẩu ứng dụng)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
